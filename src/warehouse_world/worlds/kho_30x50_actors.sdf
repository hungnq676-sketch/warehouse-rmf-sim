<?xml version="1.0"?>
<!--
  World rong: chi co vat ly, anh sang va cac plugin co ban.
  Kho 30x50 (URDF/Xacro) duoc spawn vao luc chay boi kho_30x50.launch.py
-->
<sdf version="1.8">
  <world name="kho">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -48 32 0 0.62 1.5708</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- Mat dat ben ngoai nha kho -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.11 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.30 1</ambient>
            <diffuse>0.35 0.45 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Nhan vien di lai tren loi di nguoi (mesh tai tu Gazebo Fuel lan dau chay) -->
    <actor name="walker_main">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0.00</time><pose>2.0 -22.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>33.00</time><pose>2.0 11.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>34.00</time><pose>2.0 11.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>67.00</time><pose>2.0 -22.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>68.00</time><pose>2.0 -22.0 1.0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="walker_north">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0.00</time><pose>-13.0 13.6 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>28.89</time><pose>13.0 13.6 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>29.89</time><pose>13.0 13.6 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>58.78</time><pose>-13.0 13.6 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>59.78</time><pose>-13.0 13.6 1.0 0 0 3.1416</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="walker_south">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0.00</time><pose>-13.5 -9.8 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>18.12</time><pose>1.0 -9.8 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>19.12</time><pose>1.0 -9.8 1.0 0 0 -1.1607</pose></waypoint>
          <waypoint><time>22.26</time><pose>2.0 -12.1 1.0 0 0 -1.1607</pose></waypoint>
          <waypoint><time>23.26</time><pose>2.0 -12.1 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>29.38</time><pose>2.0 -17.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>30.38</time><pose>2.0 -17.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>36.51</time><pose>2.0 -12.1 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>37.51</time><pose>2.0 -12.1 1.0 0 0 1.9809</pose></waypoint>
          <waypoint><time>40.64</time><pose>1.0 -9.8 1.0 0 0 1.9809</pose></waypoint>
          <waypoint><time>41.64</time><pose>1.0 -9.8 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>59.77</time><pose>-13.5 -9.8 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>60.77</time><pose>-13.5 -9.8 1.0 0 0 3.1416</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
